# Copy to .env and fill in. Never commit .env.

# --- Secrets ---
OPENAI_API_KEY=sk-your-key-here

# --- Models ---
EMBED_MODEL=text-embedding-3-small
EMBED_DIMENSIONS=1536
MODEL_UTILITY=gpt-4o-mini
MODEL_ANSWER=gpt-4o-mini

# --- Stores ---
MILVUS_URI=./data/vectors/lens.db
DB_PATH=./data/lens.db
UPLOAD_DIR=./data/uploads

# --- Ingestion limits ---
MAX_PAGES=50
MAX_FILE_BYTES=26214400
MIN_CHARS_PER_PAGE=150
OCR_TRIGGER_CHARS_PER_PAGE=150
OCR_ENGINE=easyocr

# --- Chunking ---
CHUNK_TARGET_TOKENS=500
CHUNK_OVERLAP_TOKENS=75
CHUNK_MIN_TOKENS=120
CHUNK_MAX_TOKENS=800

# --- Retrieval and generation ---
RETRIEVE_CANDIDATES=12
CONTEXT_CHUNKS=5
# Must be measured before use. See docs/EVALUATION.md.
GATE_THRESHOLD=
MAX_PER_DOCUMENT=
TEMPERATURE=0.0
CONDENSE_CHAR_THRESHOLD=1500
HISTORY_WINDOW_TURNS=6
MAX_RETRIES=3

# --- Rendering ---
PAGE_RENDER_DPI=150

# --- Backend ---
BACKEND_URL=http://127.0.0.1:8000
